# Copy to .env. The launcher loads this file automatically.
# Values set in the terminal take priority. Restart the launcher after editing.

# Website and launcher
SUNOIDA_APP_NAME="Sunoida User Guide Assistant"
SUNOIDA_HOST=127.0.0.1
SUNOIDA_PORT=8000
SUNOIDA_PORT_FALLBACK_COUNT=10
SUNOIDA_OPEN_BROWSER=true
SUNOIDA_LOG_LEVEL=info

# Local models: no API token is needed for this Ollama setup.
SUNOIDA_OLLAMA_URL=http://127.0.0.1:11434
SUNOIDA_OLLAMA_TIMEOUT=180
SUNOIDA_CHAT_MODEL=qwen2.5:0.5b
SUNOIDA_VISION_MODEL=qwen3-vl:2b-instruct
SUNOIDA_EMBED_MODEL=nomic-embed-text:v1.5
SUNOIDA_TEMPERATURE=0.1
SUNOIDA_CONTEXT_WINDOW=4096
SUNOIDA_MAX_RESPONSE_TOKENS=450

# Recent accepted chat turns kept separately for each browser conversation.
# Memory is temporary and clears on a server restart or a new conversation.
SUNOIDA_HISTORY_MAX_TURNS=4
SUNOIDA_HISTORY_MAX_CHARS=5000
SUNOIDA_HISTORY_TTL_SECONDS=1800
SUNOIDA_HISTORY_MAX_SESSIONS=100

# Search and relevance control. Similarity is not an accuracy probability.
SUNOIDA_RETRIEVAL_TOP_K=4
SUNOIDA_MIN_SIMILARITY=0.67
SUNOIDA_COLLECTION_NAME=sunoida_guides_nomic_v15

# Relative paths are resolved from the project root.
SUNOIDA_DOCS_DIR=backend/docs
SUNOIDA_DB_DIR=backend/chroma_db
SUNOIDA_CACHE_DIR=backend/.page_cache
